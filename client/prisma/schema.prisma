// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          UserRole  @default(USER)
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  experiences   Experience[]
  educations    Education[]

  @@map("users")
}

enum UserRole {
  ADMIN
  USER
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Project {
  id            Int               @id @default(autoincrement())
  title         String
  introduction  String            @db.LongText
  coverImageUrl String
  tags          ProjectTag[]
  ownerId       String
  owner         User              @relation(fields: [ownerId], references: [id])
  projectUrl    String?
  githubUrl     String?
  techItems     ProjectTechItem[]
  roles         ProjectRole[]
  content       Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("project")
}

model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  projects ProjectTag[]

  @@map("tag")
}

model ProjectTag {
  projectId Int
  tagId     Int
  order     Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@id([projectId, tagId])
  @@map("project_tag")
}

model TechItem {
  id         Int               @id @default(autoincrement())
  name       String            @unique
  slug       String            @unique
  isFrontend Boolean           @default(false)
  isBackend  Boolean           @default(false)
  projects   ProjectTechItem[]
  experiences ExperienceTechItem[]

  @@map("tech_item")
}

enum TechCategory {
  frontend
  backend
}

model ProjectTechItem {
  projectId  Int
  techItemId Int
  category   TechCategory
  order      Int
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  techItem   TechItem     @relation(fields: [techItemId], references: [id])

  @@id([projectId, techItemId, category])
  @@map("project_tech_item")
}

model Role {
  id       Int           @id @default(autoincrement())
  name     String        @unique
  projects ProjectRole[]

  @@map("role")
}

model ProjectRole {
  projectId Int
  roleId    Int
  order     Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleId], references: [id])

  @@id([projectId, roleId])
  @@map("project_role")
}



// Add user ID with each experience
model Experience {
  id          Int      @id @default(autoincrement())
  title       String
  company     String
  startDate   DateTime
  endDate     DateTime?
  description Json?
  techItems   ExperienceTechItem[]
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("experience")
  @@unique([userId, title, company])
}

model ExperienceTechItem {
  experienceId Int
  techItemId   Int

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  techItem   TechItem   @relation(fields: [techItemId], references: [id], onDelete: Cascade)

  @@id([experienceId, techItemId])
  @@map("experience_tech_item")
}

model Education {
  id          Int      @id @default(autoincrement())
  degree      String
  institution String
  startDate   DateTime
  endDate     DateTime?
  description Json?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("education")
  @@unique([userId, degree, institution])
}
